load("@npm//packages/website:astro/package_json.bzl", astro_bin = "bin")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@aspect_rules_js//js:defs.bzl", "js_test")

exports_files(["package.json", "tsconfig.json"])

npm_link_all_packages(name = "node_modules")

copy_to_bin(
    name = "srcs",
    srcs = glob(["src/**", "public/**"]) + ["tsconfig.json", "package.json"],
)

js_test(
    name = "style_contract_test",
    entry_point = "test_style_contract.mjs",
    data = glob(["src/**"]) + [":pages"],
    node_options = ["--test"],
)

genrule(
    name = "svg_symbols",
    srcs = [
        "src/assets/amazon_aurora.svg",
        "src/assets/amazon_redshift.svg",
        "src/assets/apache_spark.svg",
        "src/assets/databricks.svg",
        "src/assets/gazelle.svg",
        "src/assets/gazelle_fill.svg",
        "src/assets/google_bigquery.svg",
        "src/assets/hyper_banner.svg",
        "src/assets/hyper_monochrome.svg",
        "src/assets/iceberg.svg",
        "src/assets/iceberg_monochrome.svg",
        "src/assets/postgresql.svg",
        "src/assets/relalg_join.svg",
        "src/assets/relalg_scan.svg",
        "src/assets/salesforce.svg",
        "src/assets/salesforce_cloud.svg",
        "src/assets/salesforce_cloud_monochrome.svg",
        "src/assets/salesforce_monochrome.svg",
        "src/assets/snowflake.svg",
        "src/assets/tableau.svg",
        "src/assets/tableau_monochrome.svg",
    ],
    outs = ["dependencies/svg-symbols/symbols.generated.svg"],
    cmd = "python3 $(location generate_svg_symbols.py) --output $@ $(SRCS)",
    tools = ["generate_svg_symbols.py"],
)

sh_test(
    name = "svg_symbols_test",
    srcs = ["test_svg_symbols.sh"],
    data = ["generate_svg_symbols.py", "test_generate_svg_symbols.py"],
)

genrule(
    name = "astro_config",
    srcs = ["astro.config.tpl.ts"],
    outs = ["astro.config.generated.ts"],
    cmd = "sed -e 's|__WASM_DIR__|node_modules/hyperdb-wasm/dist|g' -e 's|__SVG_SYMBOLS_PATH__|dependencies/svg-symbols/symbols.generated.svg|g' $(location astro.config.tpl.ts) > $@",
)

genrule(
    name = "dev_config",
    srcs = ["astro.config.tpl.ts"],
    outs = ["astro.config.dev.ts"],
    cmd = "sed -e 's|__WASM_DIR__|node_modules/hyperdb-wasm/dist|g' -e 's|__SVG_SYMBOLS_PATH__|../../bazel-bin/packages/website/dependencies/svg-symbols/symbols.generated.svg|g' $(location astro.config.tpl.ts) > $@",
)

astro_bin.astro(
    name = "pages",
    srcs = [":srcs", ":astro_config", ":node_modules", ":svg_symbols"],
    args = ["build", "--config", "astro.config.generated.ts", "--outDir", "pages"],
    chdir = "packages/website",
    env = {"ASTRO_TELEMETRY_DISABLED": "1"},
    out_dirs = ["pages"],
    visibility = ["//visibility:public"],
)

copy_to_directory(
    name = "pages_deploy",
    srcs = [":pages"],
    out = "pages_deploy",
    replace_prefixes = {"pages": ""},
    visibility = ["//visibility:public"],
)

astro_bin.astro_test(
    name = "check",
    data = [":srcs", ":astro_config", ":node_modules", ":svg_symbols"],
    args = ["check", "--config", "astro.config.generated.ts"],
    chdir = "packages/website",
    env = {"ASTRO_TELEMETRY_DISABLED": "1"},
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "dev",
    srcs = ["dev.sh"],
    args = ["$(location :dev_config)"],
    data = [":dev_config", ":svg_symbols"],
    visibility = ["//visibility:public"],
)
