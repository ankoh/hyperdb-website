---
import SiteLayout from '../layouts/site_layout.astro';
import FederationAnimation from '../components/federation_animation.astro';
import JitAnimation from '../components/jit_animation.astro';
import QueryUnnestingAnimation from '../components/query_unnesting_animation.astro';
import GovernanceAnimation from '../components/governance_animation.astro';
import SqlInstrumentationAnimation from '../components/sql_instrumentation_animation.astro';
import MultimodalityAnimation from '../components/multimodality_animation.astro';
import styles from './experiments.module.css';
---

<SiteLayout title="Animation experiments" description="A playground for Hyper's animated graphics.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class={styles.gallery}>
    <header class={styles.intro}>
      <p class={styles.eyebrow}>Hyper / Experiments</p>
      <h1>Ideas in motion.</h1>
      <p>A working space for animated graphics. Nothing here is final.</p>
    </header>
    <section id="federation" class={styles.experiment} aria-labelledby="federation-heading">
      <header class={styles.experiment_heading}>
        <div>
          <p class={styles.eyebrow}>Experiment 01</p>
          <h2 id="federation-heading">Federation</h2>
        </div>
      </header>
      <FederationAnimation />
    </section>
    <section id="jit" class={styles.experiment} aria-labelledby="jit-heading">
      <header class={styles.experiment_heading}>
        <div>
          <p class={styles.eyebrow}>Experiment 02</p>
          <h2 id="jit-heading">Just-in-time code generation</h2>
        </div>
      </header>
      <JitAnimation />
    </section>
    <section id="query-unnesting" class={styles.experiment} aria-labelledby="query-unnesting-heading">
      <header class={styles.experiment_heading}>
        <div>
          <p class={styles.eyebrow}>Experiment 03</p>
          <h2 id="query-unnesting-heading">Query unnesting</h2>
        </div>
      </header>
      <QueryUnnestingAnimation />
    </section>
    <section id="reliable-governance" class={styles.experiment} aria-labelledby="governance-heading">
      <header class={styles.experiment_heading}>
        <div>
          <p class={styles.eyebrow}>Experiment 04</p>
          <h2 id="governance-heading">Reliable Governance</h2>
        </div>
      </header>
      <GovernanceAnimation />
    </section>
    <section id="embracing-sql" class={styles.experiment} aria-labelledby="sql-heading">
      <header class={styles.experiment_heading}>
        <div>
          <p class={styles.eyebrow}>Experiment 05</p>
          <h2 id="sql-heading">Embracing SQL</h2>
        </div>
      </header>
      <SqlInstrumentationAnimation />
    </section>
    <section id="multi-modality" class={styles.experiment} aria-labelledby="multi-modality-heading">
      <header class={styles.experiment_heading}>
        <div>
          <p class={styles.eyebrow}>Experiment 06</p>
          <h2 id="multi-modality-heading">Multi-Modality</h2>
        </div>
      </header>
      <MultimodalityAnimation />
    </section>
  </div>
</SiteLayout>
