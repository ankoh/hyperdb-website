---
import SiteLayout from '../layouts/site_layout.astro';
import LandingUsecaseCarousel from '../components/landing_usecase_carousel.astro';
import FederationAnimation from '../components/federation_animation.astro';
import JitAnimation from '../components/jit_animation.astro';
import QueryUnnestingAnimation from '../components/query_unnesting_animation.astro';
import PaperReference from '../components/paper_reference.astro';
import BlogReference from '../components/blog_reference.astro';
import styles from './index.module.css';
import GazelleArtwork from '../assets/gazelle_fill.svg';
import HyperArtwork from '../assets/hyper_hero.svg';
import symbolAtlasUrl from 'hyperdb-symbol-atlas';
import { Code } from 'astro:components';

const documentation = 'https://tableau.github.io/hyper-db/docs';
---

<SiteLayout description="Hyper is a fast database for analytical queries." fullWidth>
    <link slot="head" rel="stylesheet" href="/landing_usecase_carousel.css" />
    <section class={styles.intro_container} aria-label="Introducing HyperDB">
        <div class={styles.intro}>
            <div class={styles.intro_text}>
                <LandingUsecaseCarousel />
            </div>
            <svg class={styles.hero_artwork} viewBox="0 0 660 680" aria-hidden="true" focusable="false">
                <HyperArtwork x="280" y="0" width="320" height="680" />
                <GazelleArtwork x="0" y="20" width="400" height="660" />
            </svg>
        </div>
    </section>

    <section class={styles.properties} aria-label="HyperDB at a glance">
        <div class={styles.property_grid}>
            <article class={styles.property_card}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16" /></svg>
                        Unmatched Efficiency
                    </h2>
                    <p>Hyper converts SQL into highly optimized machine code, maximizing the performance of modern hardware.</p>
                    <a class={styles.text_link} href="#performance">Performance<span aria-hidden="true">&rarr;</span></a>
                </div>
            </article>

            <article class={styles.property_card}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 3h6v6H9ZM3 15h6v6H3Zm12 0h6v6h-6ZM12 9v3M6 15v-3h12v3" /></svg>
                        Powerful Planner
                    </h2>
                    <p>The Hyper team has built a strong theoretical foundation for query optimization at scale that has been adopted by the industry.</p>
                    <a class={styles.text_link} href="#query-planner">Planner<span aria-hidden="true">&rarr;</span></a>
                </div>
            </article>

            <article class={styles.property_card}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 21h18M5 17v-5m7 5V7m7 10V3" /></svg>
                        Embracing SQL
                    </h2>
                    <p>Hyper is very careful about SQL semantics and elevates apps through powerful instrumentation and transpilers.</p>
                    <a class={styles.text_link} href="#sql">SQL<span aria-hidden="true">&rarr;</span></a>
                </div>
            </article>

            <article class:list={[styles.property_card, styles.wide_card, styles.federation_card]}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 8V3m-6 9H3m18 0h-3m-6 4v5M8 8h8v8H8ZM3 3h3v3H3Zm15 0h3v3h-3ZM3 18h3v3H3Zm15 0h3v3h-3Z" /></svg>
                        Zero-Copy at Scale
                    </h2>
                    <p>Process data where it lives with aligned semantics. Hyper pushes complex subqueries to Snowflake, Google BigQuery, Databricks and many more.</p>
                    <a class={styles.text_link} href="#federation">Federation<span aria-hidden="true">&rarr;</span></a>
                </div>
                <div class:list={[styles.card_graphic, styles.federation_graphic]} data-graphic="federation" aria-hidden="true">
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#snowflake`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#databricks`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#google_bigquery`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#apache_spark`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#postgresql`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="32 38 192 180" focusable="false"><use href={`${symbolAtlasUrl}#amazon_aurora`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#amazon_redshift`} /></svg>
                    </span>
                </div>
            </article>

            <article class={styles.property_card}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6ZM8 12l3 3 5-6" /></svg>
                        Reliable Governance
                    </h2>
                    <p>Data security is key at Salesforce and Hyper implements a robust data governance system.</p>
                    <a class={styles.text_link} href="#governance">Governance<span aria-hidden="true">&rarr;</span></a>
                </div>
            </article>
        </div>
        <div id="production" class:list={[styles.property_card, styles.production_card]}>
            <svg class={styles.brand_salesforce} viewBox="0 0 273 191" aria-hidden="true" focusable="false">
                <use href={`${symbolAtlasUrl}#salesforce`} />
            </svg>
            <p>Hyper runs billions of analytical queries every day for <strong>Salesforce Data 360</strong> and <strong>Tableau</strong>.</p>
        </div>
    </section>

    <section class={styles.feature_section} id="performance" aria-labelledby="processing-heading">
        <div class={styles.section_copy}>
            <h2 id="processing-heading">Unmatched Efficiency</h2>
            <p>Hyper optimizes query plans and compiles them just-in-time into native machine code. Analytical queries are expensive and getting down to low-level hardware details pays off immediately.</p>
            <div class={styles.papers}>
                <h3>Selected papers from our team:</h3>
                <ul>
                    <li>
                        <PaperReference
                            href="https://www.vldb.org/pvldb/vol4/p539-neumann.pdf"
                            title="Efficiently Compiling Efficient Query Plans for Modern Hardware"
                            venue="VLDB 2011"
                        />
                    </li>
                    <li>
                        <PaperReference
                            href="https://db.in.tum.de/~leis/papers/morsels.pdf"
                            title="Morsel-Driven Parallelism: A NUMA-Aware Query Evaluation Framework for the Many-Core Age"
                            venue="SIGMOD 2014"
                        />
                    </li>
                    <li>
                        <PaperReference
                            href="https://db.in.tum.de/downloads/publications/datablocks.pdf"
                            title="Data Blocks: Hybrid OLTP and OLAP on Compressed Storage using both Vectorization and Compilation"
                            venue="SIGMOD 2016"
                        />
                    </li>
                    <li>
                        <PaperReference
                            href="https://db.in.tum.de/~leis/papers/adaptiveexecution.pdf"
                            title="Adaptive Execution of Compiled Queries"
                            venue="ICDE 2018"
                        />
                    </li>
                </ul>
            </div>
        </div>
        <figure class={styles.animation_panel}>
            <JitAnimation />
            <figcaption class={styles.animation_caption}>A query plan is translated to relational algebra, optimized and adaptively lowered to machine code with very low latency.</figcaption>
        </figure>
    </section>

    <section class={styles.feature_section} id="query-planner" aria-labelledby="planner-heading">
        <div class={styles.section_copy}>
            <h2 id="planner-heading">Powerful Query Planner</h2>
            <p>Query Optimization is a complex field and the Hyper team has built a very strong theoretical foundation that we share with the industry on database venues like SIGMOD and VLDB.</p>
            <div class={styles.papers}>
                <h3>Selected papers from our team:</h3>
                <ul>
                    <li>
                        <PaperReference
                            href="https://15721.courses.cs.cmu.edu/spring2020/papers/20-optimizer2/p539-moerkotte.pdf"
                            title="Dynamic Programming Strikes Back"
                            venue="SIGMOD 2008"
                        />
                    </li>
                    <li>
                        <PaperReference
                            href="https://www.btw-2015.de/res/proceedings/Hauptband/Wiss/Neumann-Unnesting_Arbitrary_Querie.pdf"
                            title="Unnesting Arbitrary Queries"
                            venue="BTW 2015"
                        />
                    </li>
                    <li>
                        <PaperReference
                            href="https://db.in.tum.de/~radke/papers/hugejoins.pdf"
                            title="Adaptive Optimization of Very Large Join Queries"
                            venue="SIGMOD 2018"
                        />
                    </li>
                    <li>
                        <PaperReference
                            href="https://www.vldb.org/pvldb/vol16/p3018-fent.pdf"
                            title="Asymptotically Better Query Optimization Using Indexed Algebra"
                            venue="SIGMOD 2023"
                        />
                    </li>
                </ul>
            </div>
        </div>
        <div class:list={[styles.animation_panel, styles.unnesting_panel]}>
            <QueryUnnestingAnimation />
            <figcaption class={styles.animation_caption}>Advanced query optimizations like the unnesting of arbitrary queries eliminate dependent joins. Here we unnest fetching the worst exam(s) of each student.</figcaption>
        </div>
    </section>


    <section class={styles.feature_section} id="federation" aria-labelledby="zero-copy-heading">
        <div class={styles.section_copy}>
            <h2 id="zero-copy-heading">Zero-Copy at Scale</h2>
            <p>Database behavior differs in subtle details and aligning semantics is crucial for correct query federation. Hyper pushes complex subqueries to Snowflake, Databricks, Google BigQuery and many more.</p>
            <div class={styles.papers}>
                <h3>Selected blog posts:</h3>
                <ul>
                    <li>
                        <BlogReference
                            href="https://www.linkedin.com/pulse/zero-copy-practice-decisions-determine-whether-works-krishnamoorthy-hhxhc/"
                            title="Zero Copy in Practice: The Decisions That Determine Whether It Works for You"
                            source="LinkedIn"
                        />
                    </li>
                    <li>
                        <BlogReference
                            href="https://www.salesforceblogger.com/2025/11/10/unlocking-peak-performance-in-zero-copy-federation-a-guide-to-data-locality/"
                            title="Unlocking Peak Performance in Zero-Copy Federation: A Guide to Data Locality"
                            source="Salesforce Blogger"
                        />
                    </li>
                    <li>
                        <BlogReference
                            href="https://developer.salesforce.com/blogs/2024/10/bring-your-google-bigquery-data-lake-to-data-cloud-part-1-data-in"
                            title="Bring Your Google BigQuery Data Lake to Data Cloud"
                            source="Salesforce Developers"
                        />
                    </li>
                    <li>
                        <BlogReference
                            href="https://www.salesforce.com/data/connectivity/zero-copy/"
                            title="Why Data 360’s Zero Copy Makes Business and Technical Sense"
                            source="Salesforce"
                        />
                    </li>
                </ul>
            </div>
        </div>
        <figure class={styles.animation_panel}>
            <FederationAnimation />
            <figcaption class={styles.animation_caption}>Hyper respects data localities during optimization and identifies subqueries that can be executed remotely.</figcaption>
        </figure>
    </section>

    <section class={styles.feature_section} id="governance" aria-labelledby="governance-heading">
        <div class={styles.section_copy}>
            <h2 id="governance-heading">Reliable Governance</h2>
            <p>Content coming soon.</p>
        </div>
    </section>

    <section class={styles.feature_section} id="sql" aria-labelledby="sql-heading">
        <div class={styles.section_copy}>
            <h2 id="sql-heading">Embracing SQL</h2>
            <p>Content coming soon.</p>
        </div>
    </section>

    <section class:list={[styles.feature_section, styles.install_section]} id="install" aria-labelledby="install-heading">
        <div class={styles.section_copy}>
            <h2 id="install-heading">Install Hyper</h2>
            <p>Start using Hyper in your environment.</p>
            <a class={styles.text_link} href={`${documentation}/installation`}>More clients and versions<span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class={styles.install_panel}>
            <fieldset class={styles.install_options}>
                <legend>Choose your environment</legend>
                <div class={styles.environment_choices}>
                    <label><input type="radio" name="environment" value="python" checked /><span>Python</span></label>
                    <label><input type="radio" name="environment" value="cpp" /><span>C++</span></label>
                    <label><input type="radio" name="environment" value="java" /><span>Java</span></label>
                    <label><input type="radio" name="environment" value="browser" /><span>Browser</span></label>
                </div>
            </fieldset>
            <div class:list={[styles.install_content, styles.python_install]}>
                <Code code="pip install tableauhyperapi" lang="bash" theme="css-variables" />
                <a class={styles.text_link} href={`${documentation}/installation/?client-language=python#language-specific-requirements`} target="_blank" rel="noopener noreferrer">Python setup instructions<span aria-hidden="true">&rarr;</span></a>
            </div>
            <div class:list={[styles.install_content, styles.cpp_install]}>
                <a class={styles.text_link} href={`${documentation}/releases#download`} target="_blank" rel="noopener noreferrer">Download the C++ package<span aria-hidden="true">&rarr;</span></a>
                <a class={styles.text_link} href={`${documentation}/installation/?client-language=cxx#language-specific-requirements`} target="_blank" rel="noopener noreferrer">C++ setup instructions<span aria-hidden="true">&rarr;</span></a>
            </div>
            <div class:list={[styles.install_content, styles.java_install]}>
                <a class={styles.text_link} href={`${documentation}/releases#download`} target="_blank" rel="noopener noreferrer">Download the Java package<span aria-hidden="true">&rarr;</span></a>
                <a class={styles.text_link} href={`${documentation}/installation/?client-language=java#language-specific-requirements`} target="_blank" rel="noopener noreferrer">Java setup instructions<span aria-hidden="true">&rarr;</span></a>
            </div>
            <div class:list={[styles.install_content, styles.browser_install]}>
                <a class={styles.text_link} href={`https://hyperdb.sh`} target="_blank" rel="noopener noreferrer">Try it in the browser<span aria-hidden="true">&rarr;</span></a>
            </div>
        </div>
    </section>
</SiteLayout>
