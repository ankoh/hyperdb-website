---
import SiteLayout from '../layouts/SiteLayout.astro';
import LandingUsecaseCarousel from '../components/LandingUsecaseCarousel.astro';
import styles from './index.module.css';
---

<SiteLayout title="Fast analytical queries" description="Hyper is a fast database for analytical queries." fullWidth>
  <link slot="head" rel="stylesheet" href="/carousel.css" />
  <section class={styles.intro}>
    <LandingUsecaseCarousel />
    <a class={styles.try_in_browser} href="https://hyperdb.sh/" target="_blank" rel="noopener noreferrer">Web Shell</a>
  </section>
  <section class={styles.usage}>
    <p class={styles.usage_label}>Hyper runs billions of queries each day for</p>
    <div class={styles.brand_logos}>
      <img class={styles.brand_logo_salesforce} src="/svg/logo/salesforce.svg" alt="Salesforce Data Cloud" />
      <img class={styles.brand_logo_tableau} src="/svg/logo/tableau.svg" alt="Tableau" />
    </div>
  </section>
</SiteLayout>
