---
import SiteLayout from '../layouts/site_layout.astro';
import LandingUsecaseCarousel from '../components/landing_usecase_carousel.astro';
import FederationAnimation from '../components/federation_animation.astro';
import styles from './index.module.css';
import symbolAtlasUrl from 'hyperdb-symbol-atlas';
import { Code } from 'astro:components';

const documentation = 'https://tableau.github.io/hyper-db/docs';
---

<SiteLayout title="Fast analytical queries" description="Hyper is a fast database for analytical queries." fullWidth>
    <link slot="head" rel="stylesheet" href="/landing_usecase_carousel.css" />
    <section class={styles.intro_container} aria-label="Introducing HyperDB">
        <div class={styles.intro}>
            <div class={styles.intro_text}>
                <LandingUsecaseCarousel />
                <div class={styles.hero_actions}>
                    <a class={styles.hero_button} href="#install">Get Hyper</a>
                    <a class={styles.hero_button} href="https://hyperdb.sh/" target="_blank" rel="noopener noreferrer">Try now</a>
                </div>
            </div>
            <svg class={styles.gazelle} viewBox="0 0 480 700" aria-hidden="true" focusable="false">
                <use href={`${symbolAtlasUrl}#gazelle_fill`} />
            </svg>
        </div>
    </section>

    <section class={styles.properties} aria-label="HyperDB at a glance">
        <div class={styles.property_grid}>
            <article id="production" class:list={[styles.property_card, styles.wide_card, styles.production_card]}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z" /></svg>
                        Powering Salesforce Data 360 and Tableau
                    </h2>
                    <p>Hyper executes billions of analytical queries every day for Salesforce Data 360 and Tableau.</p>
                    <a class={styles.text_link} href="#qualities">Meet the engine<span aria-hidden="true">&rarr;</span></a>
                </div>
                <svg class={styles.brand_salesforce} viewBox="0 0 273 191" aria-hidden="true" focusable="false">
                    <use href={`${symbolAtlasUrl}#salesforce`} />
                </svg>
            </article>

            <article class={styles.property_card}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16" /></svg>
                        SQL you know
                    </h2>
                    <p>Express your analysis with SQL. Join, aggregate, and explore your data with one query language.</p>
                    <a class={styles.text_link} href={`${documentation}/sql`}>Explore SQL<span aria-hidden="true">&rarr;</span></a>
                </div>
            </article>

            <article class={styles.property_card}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 4h16v16H4ZM8 8l3 3-3 3m5 2h4" /></svg>
                        Built into your app
                    </h2>
                    <p>Work with Hyper from Python, C++, or Java. Run the database locally, alongside your application.</p>
                    <a class={styles.text_link} href="#install">Get Hyper<span aria-hidden="true">&rarr;</span></a>
                </div>
            </article>

            <article class={styles.property_card}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16" /></svg>
                        Frontier Engine
                    </h2>
                    <p>Hyper pairs a code-generating query engine with one of the best query optimizers in the world.</p>
                    <a class={styles.text_link} href="#qualities">Explore the engine<span aria-hidden="true">&rarr;</span></a>
                </div>
            </article>

            <article class:list={[styles.property_card, styles.wide_card, styles.federation_card]}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 8V3m-6 9H3m18 0h-3m-6 4v5M8 8h8v8H8ZM3 3h3v3H3Zm15 0h3v3h-3ZM3 18h3v3H3Zm15 0h3v3h-3Z" /></svg>
                        Embracing Zero-Copy
                    </h2>
                    <p>Process data where it lives with aligned semantics. Hyper pushes complex subqueries to Snowflake, Google BigQuery, Databricks and many more.</p>
                    <a class={styles.text_link} href="#qualities">Explore zero-copy<span aria-hidden="true">&rarr;</span></a>
                </div>
                <div class:list={[styles.card_graphic, styles.federation_graphic]} data-graphic="federation" aria-hidden="true">
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#snowflake`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#google_bigquery`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#databricks`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#apache_spark`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#postgresql`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="32 38 192 180" focusable="false"><use href={`${symbolAtlasUrl}#amazon_aurora`} /></svg>
                    </span>
                    <span class={styles.federation_tile}>
                        <svg viewBox="0 0 24 24" focusable="false"><use href={`${symbolAtlasUrl}#amazon_redshift`} /></svg>
                    </span>
                </div>
            </article>

            <article class={styles.property_card}>
                <div class={styles.card_copy}>
                    <h2 class={styles.card_title}>
                        <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 21h18M5 17v-5m7 5V7m7 10V3" /></svg>
                        Proven at scale
                    </h2>
                    <p>An analytical database built for interactive workloads. Keep up with the questions your agents, dashboards, and apps ask.</p>
                    <a class={styles.text_link} href="#qualities">Explore Hyper<span aria-hidden="true">&rarr;</span></a>
                </div>
            </article>
        </div>
    </section>

    <section class={styles.feature_section} id="qualities" aria-labelledby="zero-copy-heading">
        <div class={styles.section_copy}>
            <h2 id="zero-copy-heading">Embracing Zero-Copy</h2>
            <p>Query data where it lives, without moving it into another database.</p>
            <p>Hyper pushes complex SQL subqueries to Snowflake, Databricks, Google BigQuery, and more, and reads open formats like Apache Iceberg. Combine sources in a single query with aligned semantics.</p>
        </div>
        <div class={styles.federation_panel}>
            <FederationAnimation />
        </div>
    </section>

    <section class={styles.feature_section} id="io" aria-labelledby="io-heading">
        <div class={styles.section_copy}>
            <h2 id="io-heading">Works with your stack</h2>
            <p>Hyper integrates directly with languages and data formats.</p>
            <div class={styles.stack_groups}>
                <div>
                    <h3>Clients</h3>
                    <ul>
                        <li><a href={`${documentation}/installation`}>Python</a></li>
                        <li><a href={`${documentation}/installation`}>C++</a></li>
                        <li><a href={`${documentation}/installation`}>Java</a></li>
                        <li><a href="https://hyperdb.sh/">Web shell</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Formats</h3>
                    <ul>
                        <li><a href={`${documentation}/guides/hyper_file/insert_csv`}>CSV</a></li>
                        <li><a href={`${documentation}/guides/hyper_file/create_update`}>Hyper</a></li>
                        <li><a href={`${documentation}/guides/hyper_file/geodata`}>Geospatial</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Integrations</h3>
                    <ul>
                        <li><a href={`${documentation}/guides/pandas_integration`}>Pandas</a></li>
                        <li><a href={`${documentation}/guides/hyper_file/publish`}>Tableau</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class:list={[styles.graphic_panel, styles.io_graphic]} data-graphic="io" aria-hidden="true">
            <div class={styles.io_sources}><span>CSV files</span><span>Hyper API</span></div>
            <div class={styles.io_connector}></div>
            <div class={styles.engine_node}>
                <svg viewBox="0 0 480 700" focusable="false"><use href={`${symbolAtlasUrl}#gazelle`} /></svg>
                <span>Hyper</span>
            </div>
            <div class={styles.io_connector}></div>
            <div class={styles.io_sources}><span>Query results</span><span>.hyper files</span></div>
        </div>
    </section>

    <section class:list={[styles.feature_section, styles.install_section]} id="install" aria-labelledby="install-heading">
        <div class={styles.section_copy}>
            <h2 id="install-heading">Install Hyper</h2>
            <p>Start using Hyper in your environment.</p>
            <a class={styles.text_link} href={`${documentation}/installation`}>More clients and versions<span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class={styles.install_panel}>
            <fieldset class={styles.install_options}>
                <legend>Choose your environment</legend>
                <div class={styles.environment_choices}>
                    <label><input type="radio" name="environment" value="python" checked /><span>Python</span></label>
                    <label><input type="radio" name="environment" value="cpp" /><span>C++</span></label>
                    <label><input type="radio" name="environment" value="java" /><span>Java</span></label>
                    <label><input type="radio" name="environment" value="browser" /><span>Browser</span></label>
                </div>
            </fieldset>
            <div class:list={[styles.install_content, styles.python_install]}>
                <p class={styles.install_label}>Install the Python package</p>
                <Code code="pip install tableauhyperapi" lang="bash" theme="css-variables" />
            </div>
            <div class:list={[styles.install_content, styles.cpp_install]}>
                <p class={styles.install_label}>Hyper API for C++</p>
                <p>Download the C++ package for your platform.</p>
                <a class={styles.primary_button} href={`${documentation}/releases#download`}>Download the C++ package</a>
                <a class={styles.text_link} href={`${documentation}/installation`}>C++ setup instructions<span aria-hidden="true">&rarr;</span></a>
            </div>
            <div class:list={[styles.install_content, styles.java_install]}>
                <p class={styles.install_label}>Hyper API for Java</p>
                <p>Download the Java package for your platform.</p>
                <a class={styles.primary_button} href={`${documentation}/releases#download`}>Download the Java package</a>
                <a class={styles.text_link} href={`${documentation}/installation`}>Java setup instructions<span aria-hidden="true">&rarr;</span></a>
            </div>
            <div class:list={[styles.install_content, styles.browser_install]}>
                <p class={styles.install_label}>No installation needed</p>
                <p>Run SQL queries directly in your browser.</p>
                <a class={styles.primary_button} href="https://hyperdb.sh/">Open the web shell</a>
                <a class={styles.text_link} href="/docs/hello-world/">Try the SQL playground<span aria-hidden="true">&rarr;</span></a>
            </div>
        </div>
    </section>
</SiteLayout>
