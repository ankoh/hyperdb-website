---
import SiteLayout from '../layouts/site_layout.astro';
import LandingUsecaseCarousel from '../components/landing_usecase_carousel.astro';
import styles from './index.module.css';
import symbolAtlasUrl from 'hyperdb-symbol-atlas';
import { Code } from 'astro:components';

const documentation = 'https://tableau.github.io/hyper-db/docs';
const properties = [
    {
        title: 'Powering Salesforce Data 360 and Tableau',
        description: 'Hyper executes billions of queries every day for Salesforce Data 360 and Tableau.',
        href: '#qualities',
        link: 'Meet the engine',
        icon: 'M13 2 4 14h7l-1 8 10-13h-7l0-7Z',
        graphic: 'brands',
        id: 'production',
        wide: true,
    },
    {
        title: 'SQL you know',
        description: 'Express your analysis with SQL. Join, aggregate, and explore your data with one query language.',
        href: `${documentation}/sql`,
        link: 'Explore SQL',
        icon: 'm8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16',
    },
    {
        title: 'Built into your app',
        description: 'Work with Hyper from Python, C++, or Java. Run the database locally, alongside your application.',
        href: '#install',
        link: 'Get Hyper',
        icon: 'M4 4h16v16H4ZM8 8l3 3-3 3m5 2h4',
    },
    {
        title: 'Browser ready',
        description: 'Try real analytical queries in your browser with WebAssembly. No database server to connect to.',
        href: 'https://hyperdb.sh/',
        link: 'Open the web shell',
        icon: 'M3 4h18v16H3ZM3 9h18M6 6.5h.01M9 6.5h.01m-1 6 3 2-3 2',
    },
    {
        title: 'Data in. Answers out.',
        description: 'Load CSV data, transform it with SQL, and store the results in portable .hyper files.',
        href: '#io',
        link: 'Explore data I/O',
        icon: 'M14 3H5v18h14V8Zm0 0v5h5M8 12h8m-8 4h8',
        graphic: 'files',
        wide: true,
    },
    {
        title: 'Proven at scale',
        description: 'An analytical database built for interactive workloads. Keep up with the questions your agents, dashboards, and apps ask.',
        href: '#qualities',
        link: 'Explore Hyper',
        icon: 'M3 21h18M5 17v-5m7 5V7m7 10V3',
    },
];
---

<SiteLayout title="Fast analytical queries" description="Hyper is a fast database for analytical queries." fullWidth>
    <section class={styles.intro_container} aria-label="Introducing HyperDB">
        <div class={styles.intro}>
            <div class={styles.intro_text}>
                <LandingUsecaseCarousel />
                <div class={styles.hero_actions}>
                    <a class={styles.hero_button} href="#install">Get Hyper</a>
                    <a class={styles.hero_button} href="https://hyperdb.sh/" target="_blank" rel="noopener noreferrer">Try now</a>
                </div>
            </div>
            <svg class={styles.gazelle} viewBox="0 0 480 700" aria-hidden="true" focusable="false">
                <use href={`${symbolAtlasUrl}#gazelle`} />
            </svg>
        </div>
    </section>

    <section class={styles.properties} aria-label="HyperDB at a glance">
        <div class={styles.property_grid}>
            {properties.map((property) => (
                <article id={property.id} class:list={[styles.property_card, { [styles.wide_card]: property.wide, [styles.production_card]: property.graphic === 'brands' }]}>
                    <div class={styles.card_copy}>
                        <h2 class={styles.card_title}>
                            <svg class={styles.card_icon} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={property.icon} /></svg>
                            {property.title}
                        </h2>
                        <p>{property.description}</p>
                        <a class={styles.text_link} href={property.href}>{property.link}<span aria-hidden="true">&rarr;</span></a>
                    </div>
                    {property.graphic === 'brands' && (
                        <div class:list={[styles.card_graphic, styles.brand_graphic]} data-graphic="brands" aria-hidden="true">
                            <svg class={styles.brand_salesforce} viewBox="0 0 273 191" focusable="false">
                                <use href={`${symbolAtlasUrl}#salesforce_monochrome`} />
                            </svg>
                            <svg class={styles.brand_tableau} viewBox="0 0 249.97 53" focusable="false">
                                <use href={`${symbolAtlasUrl}#tableau_monochrome`} />
                            </svg>
                        </div>
                    )}
                    {property.graphic === 'files' && (
                        <div class:list={[styles.card_graphic, styles.file_graphic]} data-graphic="files" aria-hidden="true">
                            <span class={styles.file_sheet}>CSV</span>
                            <span class={styles.file_sheet}>SQL</span>
                            <span class={styles.file_sheet}>.hyper</span>
                        </div>
                    )}
                </article>
            ))}
        </div>
    </section>

    <section class={styles.feature_section} id="qualities" aria-labelledby="qualities-heading">
        <div class={styles.section_copy}>
            <h2 id="qualities-heading">More than a query engine</h2>
            <p>Hyper includes an analytical SQL database, native client APIs, and a portable database file format.</p>
            <p>An analytical SQL database that runs locally alongside your application. Simple, fast, and portable.</p>
            <a class={styles.text_link} href={documentation}>Explore Hyper<span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class={styles.graphic_panel} data-graphic="queries" aria-hidden="true">
            <div class={styles.query_window}>
                <div class={styles.window_heading}><span>SQL</span><span>HyperDB</span></div>
                <pre><code><span class={styles.sql_keyword}>SELECT</span> region, <span class={styles.sql_function}>SUM</span>(revenue)
<span class={styles.sql_keyword}>FROM</span> sales
<span class={styles.sql_keyword}>GROUP BY</span> region;</code></pre>
            </div>
            <div class={styles.query_connector}></div>
            <div class={styles.result_window}>
                <div class={styles.result_row}><span>region</span><span>revenue</span></div>
                <div class={styles.result_row}><span>Europe</span><span>42,000</span></div>
                <div class={styles.result_row}><span>Americas</span><span>38,500</span></div>
                <div class={styles.result_row}><span>Asia Pacific</span><span>31,200</span></div>
            </div>
        </div>
    </section>

    <section class={styles.feature_section} id="io" aria-labelledby="io-heading">
        <div class={styles.section_copy}>
            <h2 id="io-heading">Works with your stack</h2>
            <p>Hyper integrates directly with languages and data formats.</p>
            <div class={styles.stack_groups}>
                <div>
                    <h3>Clients</h3>
                    <ul>
                        <li><a href={`${documentation}/installation`}>Python</a></li>
                        <li><a href={`${documentation}/installation`}>C++</a></li>
                        <li><a href={`${documentation}/installation`}>Java</a></li>
                        <li><a href="https://hyperdb.sh/">Web shell</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Formats</h3>
                    <ul>
                        <li><a href={`${documentation}/guides/hyper_file/insert_csv`}>CSV</a></li>
                        <li><a href={`${documentation}/guides/hyper_file/create_update`}>Hyper</a></li>
                        <li><a href={`${documentation}/guides/hyper_file/geodata`}>Geospatial</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Integrations</h3>
                    <ul>
                        <li><a href={`${documentation}/guides/pandas_integration`}>Pandas</a></li>
                        <li><a href={`${documentation}/guides/hyper_file/publish`}>Tableau</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class:list={[styles.graphic_panel, styles.io_graphic]} data-graphic="io" aria-hidden="true">
            <div class={styles.io_sources}><span>CSV files</span><span>Hyper API</span></div>
            <div class={styles.io_connector}></div>
            <div class={styles.engine_node}>
                <svg viewBox="0 0 480 700" focusable="false"><use href={`${symbolAtlasUrl}#gazelle`} /></svg>
                <span>Hyper</span>
            </div>
            <div class={styles.io_connector}></div>
            <div class={styles.io_sources}><span>Query results</span><span>.hyper files</span></div>
        </div>
    </section>

    <section class:list={[styles.feature_section, styles.install_section]} id="install" aria-labelledby="install-heading">
        <div class={styles.section_copy}>
            <h2 id="install-heading">Install Hyper</h2>
            <p>Start using Hyper in your environment.</p>
            <a class={styles.text_link} href={`${documentation}/installation`}>More clients and versions<span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class={styles.install_panel}>
            <fieldset class={styles.install_options}>
                <legend>Choose your environment</legend>
                <div class={styles.environment_choices}>
                    <label><input type="radio" name="environment" value="python" checked /><span>Python</span></label>
                    <label><input type="radio" name="environment" value="cpp" /><span>C++</span></label>
                    <label><input type="radio" name="environment" value="java" /><span>Java</span></label>
                    <label><input type="radio" name="environment" value="browser" /><span>Browser</span></label>
                </div>
            </fieldset>
            <div class:list={[styles.install_content, styles.python_install]}>
                <p class={styles.install_label}>Install the Python package</p>
                <Code code="pip install tableauhyperapi" lang="bash" theme="css-variables" />
            </div>
            <div class:list={[styles.install_content, styles.cpp_install]}>
                <p class={styles.install_label}>Hyper API for C++</p>
                <p>Download the C++ package for your platform.</p>
                <a class={styles.primary_button} href={`${documentation}/releases#download`}>Download the C++ package</a>
                <a class={styles.text_link} href={`${documentation}/installation`}>C++ setup instructions<span aria-hidden="true">&rarr;</span></a>
            </div>
            <div class:list={[styles.install_content, styles.java_install]}>
                <p class={styles.install_label}>Hyper API for Java</p>
                <p>Download the Java package for your platform.</p>
                <a class={styles.primary_button} href={`${documentation}/releases#download`}>Download the Java package</a>
                <a class={styles.text_link} href={`${documentation}/installation`}>Java setup instructions<span aria-hidden="true">&rarr;</span></a>
            </div>
            <div class:list={[styles.install_content, styles.browser_install]}>
                <p class={styles.install_label}>No installation needed</p>
                <p>Run SQL queries directly in your browser.</p>
                <a class={styles.primary_button} href="https://hyperdb.sh/">Open the web shell</a>
                <a class={styles.text_link} href="/docs/hello-world/">Try the SQL playground<span aria-hidden="true">&rarr;</span></a>
            </div>
        </div>
    </section>
</SiteLayout>
