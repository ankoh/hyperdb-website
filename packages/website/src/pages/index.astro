---
import SiteLayout from '../layouts/SiteLayout.astro';
import WordCarousel from '../components/WordCarousel.astro';
import styles from './index.module.css';
---

<SiteLayout title="Fast analytical queries" description="Hyper is a fast database for analytical queries.">
  <link slot="head" rel="stylesheet" href="/carousel.css" />
  <section class={styles.intro}>
    <WordCarousel />
    <a class={styles.try_in_browser} href="https://hyperdb.sh/" target="_blank" rel="noopener noreferrer">Web Shell</a>
  </section>
  <section class={styles.usage}>
    <div class={styles.brand_logos}>
      <img class={styles.brand_logo_salesforce} src="/svg/logo/salesforce.svg" alt="" />
      <img class={styles.brand_logo_tableau} src="/svg/logo/tableau.svg" alt="" />
    </div>
    <p>Hyper runs billions of queries each day for <span className={styles.usage_location}>Salesforce Data Cloud</span> and <span class={styles.usage_location}>Tableau</span>.</p>
  </section>
</SiteLayout>
