---
import styles from './site_layout.module.css';
import theme from './theme.module.css';
import ThemePreference from '../components/theme_preference.astro';
import faviconUrl from '../assets/favicon.svg?url';
import symbolAtlasUrl from 'hyperdb-symbol-atlas';

interface Props {
  title: string;
  description: string;
  fullWidth?: boolean;
  underHeader?: boolean;
}

const { title, description, fullWidth = false, underHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class={theme.root} data-theme="system">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Restore the preference before paint; CSS resolves the system scheme.
      try {
        const preference = localStorage.getItem('theme');
        if (preference === 'light' || preference === 'dark') {
          document.documentElement.dataset.theme = preference;
        }
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={faviconUrl} type="image/svg+xml" />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class:list={[styles.body, { [styles.under_header]: underHeader }]}>
    <header class={styles.header}>
      <a href="/" aria-label="Hyper Engineering Blog home">
        <svg class={styles.header_logo} viewBox="0 0 740 140" aria-hidden="true" focusable="false">
          <use href={`${symbolAtlasUrl}#hyper_banner`} />
        </svg>
        <span class={styles.blog_label}>Engineering Blog</span>
      </a>
      <nav class={styles.navigation} aria-label="Main navigation">
        <a href="/team/" aria-current={Astro.url.pathname.replace(/\/$/, '') === '/team' ? 'page' : undefined}>About</a>
      </nav>
      <div class={styles.header_actions}>
        <div class={styles.button_group} role="group" aria-label="Get started with Hyper">
        <a class={styles.get_hyper} href="https://tableau.github.io/hyper-db/docs/installation" target="_blank" rel="noopener noreferrer">
          <svg class={styles.action_icon} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <use href={`${symbolAtlasUrl}#download_16`} />
          </svg>
          <span class={styles.action_label}>Install</span><span class={styles.new_tab_hint}> (opens in a new tab)</span>
        </a>
        <a class={styles.browser_action} href="https://hyperdb.sh" target="_blank" rel="noopener noreferrer">
          <svg class={styles.action_icon} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <use href={`${symbolAtlasUrl}#paper_airplane_16`} />
          </svg>
          <span class={styles.action_label}>Run</span><span class={styles.new_tab_hint}> (opens in a new tab)</span>
        </a>
        <ThemePreference class={styles.theme_action} />
        </div>
      </div>
    </header>
    <main class:list={[styles.main, { [styles.main_full_width]: fullWidth }]}><slot /></main>
  </body>
</html>
