---
import styles from './SiteLayout.module.css';
import layoutCss from './SiteLayout.module.css?inline';
import faviconUrl from '../assets/favicon.svg?url';
import hyperLogoUrl from '../assets/hyper-banner.svg?url';

interface Props {
  title: string;
  description: string;
  fullWidth?: boolean;
}

const { title, description, fullWidth = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={faviconUrl} type="image/svg+xml" />
    <style is:global set:html={layoutCss} />
    <slot name="head" />
    <title>{title} | HyperDB</title>
  </head>
  <body class={styles.body}>
  <header class={styles.header}><a href="/" aria-label="HyperDB home"><img class={styles.header_logo} src={hyperLogoUrl} alt="" /></a> <nav aria-label="Main navigation"><a href="/docs/hello-world/">Docs</a></nav></header>
    <main class:list={[styles.main, { [styles.main_full_width]: fullWidth }]}><slot /></main>
    <footer class={styles.footer}>HyperDB</footer>
  </body>
</html>
