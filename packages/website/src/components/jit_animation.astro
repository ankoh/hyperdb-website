---
import styles from './jit_animation.module.css';
import symbolAtlasUrl from 'hyperdb-symbol-atlas';

const assembly = [
  { operator: 'orders', label: '.probe:' },
  { operator: 'orders', instruction: 'mov', operands: 'rax, [rdi]' },
  { operator: 'join', instruction: 'imul', operands: 'rax, r8' },
  { operator: 'join', instruction: 'and', operands: 'rax, r9' },
  { operator: 'join', instruction: 'mov', operands: 'rcx, [rsi+rax*8]' },
  { operator: 'join', instruction: 'cmp', operands: 'rcx, [rdi]' },
  { operator: 'join', instruction: 'jne', operands: '.next' },
  { operator: 'join', instruction: 'mov', operands: '[rdx], rcx' },
  { operator: 'join', instruction: 'add', operands: 'rdx, 8' },
  { operator: 'orders', label: '.next:', instruction: 'add', operands: 'rdi, 8' },
  { operator: 'orders', instruction: 'cmp', operands: 'rdi, r10' },
  { operator: 'orders', instruction: 'jb', operands: '.probe' },
];
---

<div class={styles.experiment} data-jit-animation>
  <figure class={styles.figure}>
    <div class={styles.viewport} tabindex="0" role="region" aria-label="Just-in-time compilation diagram; hover or focus to show the final highlighted stage. Scroll horizontally on small screens.">
      <svg class={styles.diagram} viewBox="0 0 430 160" role="img" aria-label="Hyper compiles a SQL query in four steps: SQL appears on the left; a query plan with orders and customers feeding a join appears in the middle; the relations exchange positions to optimize the join order; then native x86 code appears on the right. Finally, matching colors connect code to operators: blue for the orders scan and loop, and purple for join hashing, hash-table lookup, key comparison, branching, and output. Both operator borders are solid. The customers node remains unhighlighted.">
        <g aria-hidden="true">
          <text class={styles.code} x="12" y="60">
            <tspan x="12"><tspan class={styles.keyword}>select</tspan> o.id</tspan>
            <tspan x="12" dy="17"><tspan class={styles.keyword}>from</tspan> orders o</tspan>
            <tspan x="12" dy="17"><tspan class={styles.keyword}>join</tspan> customers c</tspan>
            <tspan x="24" dy="17"><tspan class={styles.keyword}>on</tspan> o.id = c.id</tspan>
          </text>

          <g class={styles.plan} data-query-plan>
            <path class={styles.step_arrow} data-step-arrow="sql-to-plan" d="M139 82H163M159 78l4 4-4 4" />
            <g class={styles.edges}>
              <path class={styles.orders_edge} d="M218 64V75Q218 79 214 79H194Q190 79 190 83V90" />
              <path class={styles.customers_edge} d="M218 64V75Q218 79 222 79H242Q246 79 246 83V90" />
            </g>
            <g class={styles.operator} data-plan-operator="join">
              <rect x="201" y="36" width="34" height="28" rx="6" />
              <rect class={styles.operator_outline} x="201" y="36" width="34" height="28" rx="6" />
              <svg x="209" y="41" width="18" height="18" viewBox="0 0 16 16" focusable="false">
                <use href={`${symbolAtlasUrl}#relalg_join`} />
              </svg>
            </g>
            <g class:list={[styles.operator, styles.orders]} data-plan-operator="orders">
              <rect x="174" y="90" width="32" height="28" rx="6" />
              <rect class={styles.operator_outline} x="174" y="90" width="32" height="28" rx="6" />
              <svg x="181" y="95" width="18" height="18" viewBox="0 0 16 16" focusable="false">
                <use href={`${symbolAtlasUrl}#relalg_scan`} />
              </svg>
              <text x="190" y="134" text-anchor="middle">orders</text>
            </g>
            <g class:list={[styles.operator, styles.customers]} data-plan-operator="customers">
              <rect x="230" y="90" width="32" height="28" rx="6" />
              <svg x="237" y="95" width="18" height="18" viewBox="0 0 16 16" focusable="false">
                <use href={`${symbolAtlasUrl}#relalg_scan`} />
              </svg>
              <text x="246" y="134" text-anchor="middle">customers</text>
            </g>
          </g>

          <g class={styles.native_code}>
            <path class={styles.step_arrow} data-step-arrow="plan-to-code" d="M273 82H293M289 78l4 4-4 4" />
            <g class:list={[styles.code, styles.assembly]}>
              {assembly.map((line, index) => (
                <g data-code-operator={line.operator}>
                  <rect class={styles.line_background} x="301" y={7 + index * 12} width="117" height="12" rx="2" />
                  <text x="305" y={16 + index * 12}>
                    {line.label && <tspan>{line.label} </tspan>}
                    {line.instruction && <><tspan class={styles.keyword}>{line.instruction}</tspan>{` ${line.operands}`}</>}
                  </text>
                </g>
              ))}
            </g>
          </g>
        </g>
      </svg>
    </div>
    <figcaption class={styles.caption}>
      Hyper turns SQL into a query plan, optimizes the join order by swapping its inputs,
      and generates native x86 machine code just in time. Blue outlines match the orders
      scan and loop, and purple outlines match join hashing, hash-table lookup, key comparison, branching,
      and output. Both operator borders are solid; the customers node remains unhighlighted. The assembly is an illustrative
      probe-loop excerpt; register setup, empty-input checks, and hash-collision handling are omitted.
    </figcaption>
  </figure>
</div>
