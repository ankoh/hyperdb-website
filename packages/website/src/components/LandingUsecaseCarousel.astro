---
import styles from './LandingUsecaseCarousel.module.css';
import css from './LandingUsecaseCarousel.module.css?inline';
import { landingUsecases } from './landing_usecases';

const count = landingUsecases.length;
const keyframes = landingUsecases.flatMap((_, index) => {
    const position = `translateY(-${index * 100 / (count + 1)}%)`;
    return [
        `${index * 100 / count}% { transform: ${position}; }`,
        `${(index + 0.8) * 100 / count}% { transform: ${position}; }`,
    ];
});
keyframes.push(`100% { transform: translateY(-${count * 100 / (count + 1)}%); }`);

const animation = count > 1 ? `
    @media (prefers-reduced-motion: no-preference) {
        .${styles.usecase_carousel} { animation: cycle-words ${count * 3}s infinite; }
    }
    @keyframes cycle-words { ${keyframes.join('\n')} }
` : '';
---

<style is:global set:html={css + animation} />
<div class={styles.your_database_text}>
    Your database for interactive&nbsp;<span class={styles.usecase_container} aria-hidden="true">
        <span class={styles.usecase_carousel}>
            {landingUsecases.map((word) => <span>{word}</span>)}
            <span>{landingUsecases[0]}</span>
        </span>
    </span>
    <span class={styles.screen_reader_only}>{landingUsecases.join(', ')}.</span>
</div>
