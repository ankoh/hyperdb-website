---
import styles from './WordCarousel.module.css';
import { carouselWords } from './carousel_words';
---

<h1>
  Your database for interactive&nbsp;<span class={styles.words} aria-hidden="true">
    <span class={styles.wordTrack}>
      {carouselWords.map((word) => <span>{word}</span>)}
      <span>{carouselWords[0]}</span>
    </span>
  </span>
  <span class={styles.srOnly}>{carouselWords.join(', ')}.</span>
</h1>
