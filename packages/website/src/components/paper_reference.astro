---
import styles from './paper_reference.module.css';

interface Props {
  href: string;
  title: string;
  venue: string;
}

const { href, title, venue } = Astro.props;
---

<a class={styles.reference} href={href}>
  <span class={styles.document} aria-hidden="true">
    <svg viewBox="0 0 16 16" focusable="false">
      <path d="M4 2h5l3 3v9H4V2Zm5 0v4h3M6 8h4M6 11h4" />
    </svg>
  </span>
  <span class={styles.copy}>
    <span class={styles.title}>{title}</span>
    <span class={styles.venue}>{venue}</span>
  </span>
</a>
