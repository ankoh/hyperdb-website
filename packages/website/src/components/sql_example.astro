---
import TrySQL from '../islands/try_sql';
import styles from './sql_example.module.css';
import { Code } from 'astro:components';

interface Props {
  sql: string;
}

const { sql } = Astro.props;
---

<div class={styles.example}>
  <Code code={sql} lang="sql" theme="css-variables" />
  <TrySQL sql={sql} client:load />
</div>
