---
import styles from './vector_search_animation.module.css';
import timing from './animation_timing.module.css';

const clusters = [
  { theme: 'Cars', color: 'mobility', split: 'cars', searched: true },
  { theme: 'Tech', color: 'discovery', searched: true },
  { theme: 'Food', color: 'living', split: 'food' },
  { theme: 'Travel', color: 'mobility', searched: true },
  { theme: 'Music', color: 'culture', split: 'music' },
  { theme: 'Nature', color: 'living' },
];
const points = [[22, 30], [39, 39], [24, 52], [47, 58], [35, 66], [60, 31], [78, 43], [97, 32], [89, 56], [108, 66], [72, 68]];
const inserts = [
  { x: 52, y: 49, color: 'mobility' },
  { x: 117, y: 50, color: 'mobility' },
  { x: 203, y: 133, color: 'culture' },
  { x: 353, y: 49, color: 'living' },
  { x: 266, y: 136, color: 'culture' },
  { x: 417, y: 50, color: 'living' },
];
---

<figure class:list={[styles.figure, timing.cycle]} data-vector-animation tabindex="0" aria-label="Vector index animation. Hover or focus to pause.">
  <svg class={styles.diagram} viewBox="0 0 450 174" role="img" aria-label="Schematic vector index, not a literal index trace. Dots represent data in six boxes; crosses mark their centroids. Inserts arrive in several boxes, which split simultaneously. Each split replaces one centroid with two. A subsequent search highlights candidate points across three neighboring boxes.">
    <g aria-hidden="true">
      {clusters.map((cluster, i) => <g transform={`translate(${(i % 3) * 150 + 5}, ${Math.floor(i / 3) * 84 + 5})`} data-color={cluster.color} data-split={cluster.split} data-searched={cluster.searched ? 'true' : undefined}>
        <rect class:list={[styles.partition, cluster.searched && styles.relevant]} width="138" height="76" rx="4" />
        {points.map(([cx, cy]) => <circle class={styles.point} cx={cx} cy={cy} r="2.8" />)}
        <path class:list={[styles.centroid, cluster.split && styles.old_centroid]} d="M64 44h10m-5-5v10" />
        {cluster.split && <g class={styles.split}>
          <path d="M69 0V76" pathLength="1" />
        </g>}
        {cluster.split && <path class:list={[styles.centroid, styles.new_centroids]} d="M30 44h10m-5-5v10M98 44h10m-5-5v10" />}
      </g>)}
      {inserts.map((point, i) => <g class:list={[styles.incoming, i > 2 && styles.second_insert]} data-color={point.color}>
        <circle class={styles.point} cx={point.x} cy={point.y} r="2.8" />
      </g>)}
      <g class={styles.search}>
        <ellipse cx="77" cy="51" rx="54" ry="22" />
        <ellipse cx="193" cy="56" rx="25" ry="17" />
        <ellipse cx="90" cy="129" rx="27" ry="18" />
        <path class={styles.search_links} d="M129 70L117 50M129 70L52 49M129 70L194 44M129 70L179 57M129 70L83 132M129 70L102 121" />
        <circle cx="52" cy="49" r="4.5" /><circle cx="117" cy="50" r="4.5" />
        <circle cx="194" cy="44" r="4.5" /><circle cx="179" cy="57" r="4.5" />
        <circle cx="83" cy="132" r="4.5" /><circle cx="102" cy="121" r="4.5" />
        <path class={styles.query_dot} d="M129 64L135 70L129 76L123 70Z" />
      </g>
    </g>
  </svg>
</figure>
