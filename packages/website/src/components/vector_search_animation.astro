---
import styles from './vector_search_animation.module.css';

const stablePoints = [[76, 89], [101, 110], [72, 134], [122, 151], [88, 174], [141, 95], [150, 189], [396, 81], [421, 110], [386, 135], [431, 173], [387, 192], [415, 224]];
const growingPoints = [[222, 82], [247, 106], [218, 132], [253, 155], [224, 190], [263, 215], [281, 84], [309, 110], [285, 147], [321, 179], [295, 222]];
---

<figure class={styles.figure}>
  <div class={styles.viewport} tabindex="0" role="region" aria-label="Vector index animation. Hover or focus to pause local rebalancing and search.">
    <svg class={styles.diagram} viewBox="0 0 500 320" role="img" aria-label="Illustration of SPFresh-style incremental updates. New vectors enter a growing partition. It splits into two partitions with new centroids, and two nearby boundary vectors are reassigned. Other partitions remain unchanged. A query then selects nearby vectors across the updated boundary. This is a schematic two-dimensional projection, not a literal index trace.">
      <g aria-hidden="true">
        <path class={styles.partition} d="M34 40H172V268H34ZM362 40H466V268H362" />
        <path class:list={[styles.partition, styles.growing]} d="M172 40H362V268H172Z" />
        <path class={styles.split} pathLength="1" d="M276 40L276 121L263 181L281 268" />
        <g class={styles.points}>
          {stablePoints.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.5" />)}
          {growingPoints.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.5" />)}
        </g>
        <g class={styles.centroids}>
          <path d="M106 148h10m-5-5v10M409 148h10m-5-5v10" />
          <path class={styles.old_centroid} d="M262 148h10m-5-5v10" />
          <path class={styles.new_centroids} d="M230 145h10m-5-5v10M304 148h10m-5-5v10" />
        </g>
        <g class={styles.incoming}>
          <circle class={styles.insert_one} cx="244" cy="126" r="4.5" />
          <circle class={styles.insert_two} cx="258" cy="174" r="4.5" />
          <circle class={styles.insert_three} cx="287" cy="184" r="4.5" />
        </g>
        <g class={styles.reassigned}>
          <circle class={styles.move_left} cx="279" cy="117" r="4" />
          <circle class={styles.move_right} cx="259" cy="199" r="4" />
        </g>
        <g class={styles.search}>
          <ellipse cx="279" cy="175" rx="49" ry="43" />
          <path class={styles.search_links} d="M279 175L253 155M279 175L285 147M279 175L287 184M279 175L274 199" />
          <g class={styles.results}>
            <circle cx="253" cy="155" r="5" /><circle cx="285" cy="147" r="5" />
            <circle cx="287" cy="184" r="5" /><circle cx="274" cy="199" r="5" />
          </g>
          <path class={styles.query} d="M279 168L286 175L279 182L272 175Z" />
        </g>
        <g class={styles.phase_labels}>
          <text class={styles.update_label} x="250" y="302">Incremental updates</text>
          <text class={styles.rebalance_label} x="250" y="302">Local split + boundary reassignment</text>
          <text class={styles.search_label} x="250" y="302">Nearest-neighbor search</text>
        </g>
      </g>
    </svg>
  </div>
</figure>
