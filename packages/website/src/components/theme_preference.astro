---
import styles from './theme_preference.module.css';
import symbolAtlasUrl from 'hyperdb-symbol-atlas';

interface Props { class?: string; }
const { class: className } = Astro.props;
---

<button
  class:list={[styles.toggle, className]}
  type="button"
  aria-label="Dark"
  title="Dark Mode"
  data-theme-preference
  disabled
>
      <svg class={styles.sun} aria-hidden="true" viewBox="0 0 16 16" focusable="false">
        <use href={`${symbolAtlasUrl}#sun_16`} />
      </svg>
      <svg class={styles.moon} aria-hidden="true" viewBox="0 0 16 16" focusable="false">
        <use href={`${symbolAtlasUrl}#moon_16`} />
      </svg>
  <span class={styles.label}>
    <span class={styles.moon}>Dark</span>
    <span class={styles.sun}>Light</span>
  </span>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-preference]');
  if (toggle) {
    const root = document.documentElement;
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => root.dataset.theme === 'dark' || (root.dataset.theme !== 'light' && systemTheme.matches);
    const syncToggle = () => {
      toggle.title = isDark() ? 'Light Mode' : 'Dark Mode';
      toggle.setAttribute('aria-label', toggle.title);
    };
    syncToggle();
    toggle.disabled = false;

    toggle.addEventListener('click', () => {
      const preference = isDark() ? 'light' : 'dark';
      root.dataset.theme = preference;
      syncToggle();
      try {
        localStorage.setItem('theme', preference);
      } catch {}
    });

    systemTheme.addEventListener('change', syncToggle);
    window.addEventListener('storage', (event) => {
      if (event.storageArea !== localStorage || (event.key !== 'theme' && event.key !== null)) return;
      const preference = event.key === 'theme' ? event.newValue : null;
      root.dataset.theme = preference === 'light' || preference === 'dark' ? preference : 'system';
      syncToggle();
    });
  }
</script>
