---
import styles from './query_unnesting_animation.module.css';
import timing from './animation_timing.module.css';
import symbolAtlasUrl from 'hyperdb-symbol-atlas';
---

<!-- Handoff: Illustrate Q1 from Neumann and Kemper, "Unnesting Arbitrary Queries":
     outer students ⋈ exams feed a dependent join whose right side filters exams by
     the current student ID and computes min(grade). Unnest by forming distinct student
     IDs from the outer rows (domain D), pushing D into that right-side query, grouping
     by D.id while retaining a correlated s.id = D.id selection, then substituting
     exams.sid for D.id and removing the D join and correlated selection. The final
     right subtree is only exams grouped by sid; it must not contain a students scan.
     Convey the three plans through the edges and moving operator nodes, without fades,
     explanatory captions, or rotating operators. -->
<figure class:list={[styles.figure, timing.cycle]}>
  <div class={styles.viewport} tabindex="0" role="region" aria-label="Query unnesting animation. Hover or focus to pause.">
    <svg class={styles.diagram} viewBox="-20 0 550 282" role="img" aria-label="A correlated minimum over exams is unnested. Initially, a dependent join evaluates the minimum exam grade for each outer student and exam row. Distinct student IDs from the outer rows are then pushed into the subquery and joined with exams, while a selection matching the domain ID to the current student keeps the top join dependent. Finally, the domain join and correlated selection are eliminated by substituting the exam student ID. The top join is now ordinary, and the right subtree groups and scans exams only, with no students relation.">
      <g class={styles.edges} aria-hidden="true">
        <path d="M258 36V54" />
        <path d="M258 78V90Q258 94 254 94H94Q90 94 90 98V128" />
        <path class={`${styles.initial_edge} ${styles.initial_right_branch}`} d="M258 78L258 90Q258 94 262 94L342 94Q346 94 346 98L346 108" />
        <path class={`${styles.domain_draw_edge} ${styles.domain_right_extension}`} pathLength="1" d="M346 108V148" />
        <path class={`${styles.domain_edge_stage} ${styles.domain_right_branch}`} d="M258 78L258 90Q258 94 262 94L342 94Q346 94 346 98L346 148" />
        <path class={`${styles.final_edge} ${styles.final_right_branch}`} d="M258 78L258 90Q258 94 262 94L342 94Q346 94 346 98L346 128" />
        <path d="M90 152V176Q90 180 86 180H36Q32 180 32 184V202" />
        <path d="M90 152V176Q90 180 94 180H144Q148 180 148 184V202" />
        <path class={`${styles.initial_edge} ${styles.initial_aggregate_edge}`} d="M346 132L346 152" />
        <path class={`${styles.aggregate_transition} ${styles.aggregate_transition_in}`} d="M346 132L346 152" />
        <path class={`${styles.domain_hold_edge} ${styles.domain_aggregate_edge}`} d="M346 172L346 192" />
        <path class={`${styles.initial_edge} ${styles.initial_scan_edge}`} d="M346 176L346 202" />
        <path class={styles.scan_transition} d="M346 216L346 222Q346 226 350 226L392 226Q396 226 396 230L396 236" />
        <path class={`${styles.domain_hold_edge} ${styles.domain_scan_edge}`} d="M346 216L346 222Q346 226 350 226L392 226Q396 226 396 230L396 236" />
        <path class={`${styles.final_edge} ${styles.final_scan_edge}`} d="M346 152L346 202" />
        <path class={styles.correlation_edge} pathLength="1" d="M32 226V236Q32 240 36 240H256Q260 240 260 236V168Q260 164 264 164H334" />
        <path class={`${styles.domain_draw_edge} ${styles.domain_join_edge}`} pathLength="1" d="M346 216L346 222Q346 226 342 226L284 226Q280 226 280 230L280 236" />
        <path class={`${styles.domain_draw_edge} ${styles.domain_feed_edge}`} pathLength="1" d="M102 140L236 140Q240 140 240 144L240 222Q240 226 244 226L276 226Q280 226 280 230L280 236" />
      </g>

      <g class={styles.nodes} aria-hidden="true">
        <g class={`${styles.operator} ${styles.filter}`}>
          <rect x="-12" y="-12" width="24" height="24" rx="5" />
          <text class={styles.symbol} y="4" text-anchor="middle">σ</text>
          <text x="20" y="4">e.grade = m</text>
        </g>
        <g class={`${styles.operator} ${styles.root_join}`}>
          <rect x="-12" y="-12" width="24" height="24" rx="5" />
          <svg class={styles.final_label} x="-8" y="-8" width="16" height="16" viewBox="0 0 16 16" focusable="false"><use href={`${symbolAtlasUrl}#relalg_join`} /></svg>
          <g class={styles.dependent_label}>
            <path class={styles.dependency_fill} d="M0 0L5 -5V5Z" />
            <path class={styles.dependency_mark} d="M-5 5L5 -5V5L-5 -5Z" />
          </g>
          <text class={styles.dependent_label} x="18" y="4">dependent</text>
          <text class={styles.final_label} x="18" y="4">s.id = e2.sid</text>
        </g>
        <g class={`${styles.operator} ${styles.outer_join}`}>
          <rect x="-12" y="-12" width="24" height="24" rx="5" />
          <svg x="-8" y="-8" width="16" height="16" viewBox="0 0 16 16" focusable="false"><use href={`${symbolAtlasUrl}#relalg_join`} /></svg>
          <text x="-20" y="4" text-anchor="end">s.id = e.sid</text>
        </g>
        <g class={`${styles.operator} ${styles.aggregate}`}>
          <rect x="-12" y="-12" width="24" height="24" rx="5" />
          <svg x="-8" y="-8" width="16" height="16" viewBox="0 0 16 16" focusable="false"><use href={`${symbolAtlasUrl}#relalg_group`} /></svg>
          <text class={styles.initial_label} x="18" y="4">min(e2.grade)</text>
          <text class={styles.domain_label} x="18" y="4">d.id, min(e2.grade)</text>
          <text class={styles.final_label} x="18" y="4">e2.sid, min(e2.grade)</text>
        </g>
        <g class={`${styles.operator} ${styles.domain_selection}`}>
          <rect x="-12" y="-12" width="24" height="24" rx="5" />
          <text class={styles.symbol} y="4" text-anchor="middle">σ</text>
          <text x="18" y="4">s.id = d.id</text>
        </g>
        <g class={`${styles.operator} ${styles.subquery_join}`}>
          <rect x="-12" y="-12" width="24" height="24" rx="5" />
          <text class={`${styles.symbol} ${styles.initial_label}`} y="4" text-anchor="middle">σ</text>
          <text class={styles.initial_label} x="18" y="4">s.id = e2.sid</text>
          <svg class={styles.domain_label} x="-8" y="-8" width="16" height="16" viewBox="0 0 16 16" focusable="false"><use href={`${symbolAtlasUrl}#relalg_join`} /></svg>
          <text class={styles.domain_label} x="18" y="4">d.id = e2.sid</text>
        </g>
        <g class={`${styles.operator} ${styles.domain_projection}`}>
          <rect x="-12" y="-12" width="24" height="24" rx="5" />
          <text class={styles.symbol} y="4" text-anchor="middle">δ</text>
          <text x="20" y="4">s.id</text>
        </g>
        <g class={`${styles.operator} ${styles.student_scan}`}>
          <rect x="-12" y="-12" width="24" height="24" rx="5" />
          <svg x="-8" y="-8" width="16" height="16" viewBox="0 0 16 16" focusable="false"><use href={`${symbolAtlasUrl}#relalg_scan`} /></svg>
          <text x="20" y="4">students s</text>
        </g>
        <g class={`${styles.operator} ${styles.outer_exam_scan}`}>
          <rect x="-12" y="-12" width="24" height="24" rx="5" />
          <svg x="-8" y="-8" width="16" height="16" viewBox="0 0 16 16" focusable="false"><use href={`${symbolAtlasUrl}#relalg_scan`} /></svg>
          <text x="20" y="4">exams e</text>
        </g>
        <g class={`${styles.operator} ${styles.inner_exam_scan}`}>
          <rect x="-12" y="-12" width="24" height="24" rx="5" />
          <svg x="-8" y="-8" width="16" height="16" viewBox="0 0 16 16" focusable="false"><use href={`${symbolAtlasUrl}#relalg_scan`} /></svg>
          <text x="20" y="4">exams e2</text>
        </g>
      </g>
      <g class={styles.stage_labels} aria-hidden="true">
        <text class={styles.input_step} x="-4" y="24">1 / 3  Correlated</text>
        <text class={styles.domain_step} x="-4" y="24">2 / 3  Domain</text>
        <text class={styles.final_step} x="-4" y="24">3 / 3  Final plan</text>
      </g>
    </svg>
  </div>
</figure>
